<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 网络权限 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="网络权限 (Internet)"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvNetworkStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="未授予"
                android:textColor="@android:color/holo_red_dark" />

            <Button
                android:id="@+id/btnRequestNetwork"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="检查"
                android:visibility="invisible" />
        </LinearLayout>

        <Button
            android:id="@+id/btnEnterIoTActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_default_focused"
            android:enabled="false"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@+id/tvNetworkStatus"
            android:padding="12dp"
            android:text="进入物联网应用"
            android:textColor="@android:color/black"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
