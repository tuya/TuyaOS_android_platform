<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#EFF4F0"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="IPC 推流 Sample"
        android:textColor="#1B4332"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/tvMqttStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="未连接"
        android:textColor="#52796F"
        android:textSize="13sp"
        android:layout_marginBottom="16dp" />

    <ImageView
        android:id="@+id/ivQrCode"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="#FFFFFF"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:contentDescription="bind qr code" />

    <TextView
        android:id="@+id/tvBindStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="初始化中..."
        android:textColor="#40916C"
        android:textSize="14sp"
        android:layout_marginTop="16dp" />

</LinearLayout>
