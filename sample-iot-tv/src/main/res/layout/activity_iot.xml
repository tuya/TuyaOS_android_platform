<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

        <!-- 设备状态 -->
        <TextView
            android:id="@+id/tvBindStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:padding="12dp"
            android:text="正在初始化..."
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- 服务状态 -->
        <TextView
            android:id="@+id/tvServiceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="✗ 服务状态：未启动"
            android:textColor="@android:color/holo_orange_dark"
            android:textSize="14sp" />

        <!-- 设备 ID -->
        <TextView
            android:id="@+id/tvDeviceId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="设备 ID: 未获取"
            android:textColor="@android:color/darker_gray"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- 二维码显示区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivQrCode"
                android:layout_width="300dp"
                android:layout_height="300dp"
                android:layout_gravity="center"
                android:contentDescription="配网二维码"
                android:scaleType="fitCenter"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btnResetFactory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_red_focused"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusDown="@+id/btnMoveToBackground"
            android:text="恢复出厂设置"
            android:textColor="@android:color/white"
            android:textSize="16sp" />

        <!-- 退出到后台按钮 -->
        <Button
            android:id="@+id/btnMoveToBackground"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/button_blue_focused"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:nextFocusUp="@+id/btnResetFactory"
            android:text="隐藏界面（后台运行）"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- DP 数据标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="收到的 DP 数据："
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- DP 数据显示区域 -->
        <TextView
            android:id="@+id/tvDpData"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#F5F5F5"
            android:padding="12dp"
            android:text="等待接收 DP 数据..."
            android:textSize="12sp" />

</LinearLayout>
